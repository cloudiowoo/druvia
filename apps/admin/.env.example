# Admin build-time environment
# These values are bundled into the Next.js build.

# Local development defaults
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_HASURA_URL=http://localhost:8180

# Production single-domain example
# NEXT_PUBLIC_API_URL=https://druvia.logisticservice.site
# NEXT_PUBLIC_HASURA_URL=https://druvia.logisticservice.site

# Tenant mode
NEXT_PUBLIC_MULTI_TENANT_ENABLED=false
NEXT_PUBLIC_DEFAULT_TENANT_ID=default
