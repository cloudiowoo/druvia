# Standalone Docker Registry environment.
# Copy to `.env` before starting docker-compose.yml.

# Bind to localhost by default and put HTTPS on a host-level reverse proxy.
# Use 0.0.0.0 only when the registry container terminates TLS itself or sits
# behind a trusted firewall.
REGISTRY_BIND_ADDR=127.0.0.1
REGISTRY_PORT=5000

# Required by registry:2. Generate a long random value before production use:
#   openssl rand -hex 32
REGISTRY_HTTP_SECRET=change_me_to_a_random_32_byte_hex_secret

# Auth file must exist at registry_auth/htpasswd before startup:
#   docker run --rm --entrypoint htpasswd httpd:2 -Bbn druvia '<strong-password>' > registry_auth/htpasswd
REGISTRY_AUTH_HTPASSWD_REALM=Druvia Registry

# Enables manifest deletion. Run registry garbage collection during maintenance
# windows before reclaiming disk space.
REGISTRY_STORAGE_DELETE_ENABLED=true
