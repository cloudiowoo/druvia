# Druvia production Docker environment
# Copy to `docker/.env.prod` and use with:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# === Required secrets ===
POSTGRES_PASSWORD=p@sscode1234!
# URL-encoded: @ -> %40, ! -> %21
POSTGRES_PASSWORD_ENCODED=p%40sscode1234%21
JWT_SECRET=druvia_jwt_secret_key_min_32_characters
HASURA_ADMIN_SECRET=druvia_hasura_secret
STORAGE_TRUSTED_TICKET_SECRET=your_storage_trusted_ticket_secret_min_32_chars

# === API / browser-facing origin ===
# Single-domain deployment behind nginx / reverse proxy:
# keep both values pointing at the public site origin.
# Do not leave them empty in the current codebase, because some Admin pages
# still fall back to localhost when these variables are missing.
# `API_BASE_URL` is used by the API itself when generating storage public URLs
# and signed download URLs, so it should also point at the public site origin.
API_BASE_URL=https://druvia.logisticservice.site
INTERNAL_API_BASE_URL=http://api:3001
DENO_WORKER_URL=http://deno:7133
CORS_ORIGINS=https://druvia.logisticservice.site
TRUST_PROXY=true
NEXT_PUBLIC_API_URL=https://druvia.logisticservice.site
NEXT_PUBLIC_HASURA_URL=https://druvia.logisticservice.site

# Admin runtime variables
NEXT_PUBLIC_MULTI_TENANT_ENABLED=false
NEXT_PUBLIC_DEFAULT_TENANT_ID=default

POSTGRES_PORT=5432
REDIS_PORT=6379
HASURA_PORT=8080
DENO_PORT=7133

# # Optional nginx profile ports (`--profile with-nginx`)
HTTP_PORT=80
HTTPS_PORT=443

# DNSPod-backed Let's Encrypt for built-in nginx profile
CERTBOT_EMAIL=admin@logisticservice.site
CERTBOT_PRIMARY_DOMAIN=logisticservice.site
CERTBOT_WILDCARD_DOMAIN=*.logisticservice.site

# Optional logging stack (`--profile with-logs`)
LOKI_PORT=3100
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Note:
# - If TLS / proxying is handled by an external nginx on the host, the Docker
#   `with-nginx` profile is optional.
# - In that setup, the external proxy must still route `/`, `/api/`,
#   `/v1/graphql`, and `/v1/graphql/ws` to the proper containers.
