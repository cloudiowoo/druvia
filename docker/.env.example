# Druvia local Docker environment
# Copy to `docker/.env` and adjust as needed.
# Used by `docker-compose.local.yml` and local infra stacks under `docker/`.

# Database
POSTGRES_PASSWORD=your_local_postgres_password
# URL-encoded password for Hasura (@ -> %40, ! -> %21, # -> %23, $ -> %24, etc.)
# Example: p@ssword! -> p%40ssword%21
POSTGRES_PASSWORD_ENCODED=your_local_postgres_password_url_encoded
POSTGRES_PORT=5532

# Core secrets
JWT_SECRET=your_jwt_secret_key_min_32_characters
HASURA_ADMIN_SECRET=your_hasura_admin_secret
STORAGE_TRUSTED_TICKET_SECRET=your_storage_trusted_ticket_secret_min_32_characters

# API runtime
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional local nginx profile ports (`--profile with-nginx`)
HTTP_PORT=8088
HTTPS_PORT=8443

# Optional logging stack (`--profile with-logs`)
LOKI_PORT=3100
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Note:
# - `docker-compose.local.yml` does not read `NEXT_PUBLIC_API_URL` / `NEXT_PUBLIC_HASURA_URL`.
# - For local Admin builds, configure `apps/admin/.env.local` before `pnpm build`.
