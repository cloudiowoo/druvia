# Druvia Docker Environment Variables
# Copy this file to .env and fill in the values

# Database
POSTGRES_PASSWORD=your_secure_password_here
# URL-encoded password for Hasura (@ -> %40, ! -> %21, # -> %23, $ -> %24, etc.)
# Example: p@ssword! -> p%40ssword%21
POSTGRES_PASSWORD_ENCODED=your_secure_password_here_url_encoded
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# JWT Secret (min 32 characters)
JWT_SECRET=your_jwt_secret_key_min_32_characters

# Storage trusted ticket signing secret (server-side only, must differ from JWT secrets)
STORAGE_TRUSTED_TICKET_SECRET=your_storage_trusted_ticket_secret_min_32_characters

# Hasura
HASURA_ADMIN_SECRET=your_hasura_admin_secret
HASURA_PORT=8080

# Public URLs (for client-side access)
PUBLIC_API_URL=http://localhost:3001
PUBLIC_HASURA_URL=http://localhost:8080

# Optional logging stack (with-logs profile)
LOKI_PORT=3100
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
