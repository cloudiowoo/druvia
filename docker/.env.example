# Druvia local Docker environment
# Copy to `docker/.env` and adjust as needed.
# Used by `docker-compose.local.yml` and local infra stacks under `docker/`.

# Database
POSTGRES_PASSWORD=your_local_postgres_password
# URL-encoded password for Hasura (@ -> %40, ! -> %21, # -> %23, $ -> %24, etc.)
# Example: p@ssword! -> p%40ssword%21
POSTGRES_PASSWORD_ENCODED=your_local_postgres_password_url_encoded
POSTGRES_PORT=5532
POSTGRES_POSTGIS_PORT=5632
HASURA_PORT=8080
# Only used with docker-compose.local.dual-db.yml.
DRUVIA_LOCAL_DB_HOST=postgres
# Optional: used with docker-compose.postgis.yml and docker-compose.local.dual-db.yml.
# Prefer an immutable digest after validating the image for the target environment.
DRUVIA_POSTGRES_IMAGE=postgis/postgis:17-3.5-alpine
DRUVIA_POSTGRES_PLATFORM=linux/amd64

# Core secrets
JWT_SECRET=your_jwt_secret_key_min_32_characters
# Dedicated encryption key for provider and Function secrets. Required by Apple Auth.
# Generate 64 hex characters with `openssl rand -hex 32`; keep it distinct from signing secrets.
SECRETS_ENCRYPTION_KEY=replace_me_with_64_hex_characters
# Dedicated HS256 key shared only by Druvia API token issuance and Hasura verification.
# Existing deployments may temporarily omit this to fall back to JWT_SECRET.
HASURA_JWT_SECRET=change_me_to_a_distinct_32_char_min_secret
HASURA_REALTIME_TOKEN_TTL_SECONDS=300
HASURA_ADMIN_SECRET=your_hasura_admin_secret
STORAGE_TRUSTED_TICKET_SECRET=your_storage_trusted_ticket_secret_min_32_characters
# Keep these distinct outside local development. Worker secret must contain at least 32 UTF-8 bytes.
FUNCTIONS_INTERNAL_TOKEN_SECRET=your_functions_internal_token_secret_min_32_characters
DENO_WORKER_SECRET=your_worker_request_secret_min_32_utf8_bytes

# API runtime
API_PORT=3001
INTERNAL_API_BASE_URL=http://api:3001
DENO_WORKER_URL=http://deno:7133
# Direct Hasura origin. With release-mode local nginx, persist
# HASURA_PUBLIC_URL=http://localhost:8088 in .env.release instead.
HASURA_PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=true
STORAGE_PROVIDER=local
STORAGE_HOST_PATH=./storage_data

# Optional local nginx HTTP port (`--profile with-nginx`)
HTTP_PORT=8088

# Optional logging stack (`--profile with-logs`)
LOKI_PORT=3100
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Note:
# - `docker-compose.local.yml` does not read `NEXT_PUBLIC_API_URL` / `NEXT_PUBLIC_HASURA_URL`.
# - For local Admin builds, configure `apps/admin/.env.local` before `pnpm build`.
