# Druvia Production Environment Variables
# Copy to .env and fill in values

# === Required ===
POSTGRES_PASSWORD=your-secure-password
POSTGRES_PASSWORD_ENCODED=your-secure-password  # URL encoded (@ -> %40, ! -> %21)
JWT_SECRET=your-jwt-secret-min-32-chars
HASURA_ADMIN_SECRET=your-hasura-admin-secret

# === Optional ===
# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=https://your-domain.com

# Admin build-time variables (baked into JS bundle)
NEXT_PUBLIC_API_URL=https://api.your-domain.com
NEXT_PUBLIC_HASURA_URL=https://hasura.your-domain.com

# Admin runtime variables
NEXT_PUBLIC_MULTI_TENANT_ENABLED=false
NEXT_PUBLIC_DEFAULT_TENANT_ID=default

# Nginx ports (only if using nginx profile)
HTTP_PORT=80
HTTPS_PORT=443

# Optional logging stack (only if using with-logs profile)
LOKI_PORT=3100
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
