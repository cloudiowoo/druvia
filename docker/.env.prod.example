# Druvia production Docker environment
# Copy to `docker/.env.prod` and use with:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# Release-mode online update deployments also load `docker/.env.release`:
#   DRUVIA_DEPLOY_DIR="$(pwd)" docker compose --env-file .env.prod --env-file .env.release -f docker-compose.release.yml up -d

# === Required secrets ===
POSTGRES_PASSWORD=your-secure-password
POSTGRES_PASSWORD_ENCODED=your-secure-password-url-encoded
# Must be at least 32 characters for Hasura HS256 JWT verification.
JWT_SECRET=change_me_to_a_32_char_min_jwt_secret
HASURA_ADMIN_SECRET=your-hasura-admin-secret
STORAGE_TRUSTED_TICKET_SECRET=your-storage-trusted-ticket-secret-min-32-chars

# === Release-mode online update ===
# `DRUVIA_UPDATER_SECRET` must match `.env.release`.
# `DRUVIA_DEPLOY_DIR` is defined in `.env.release` and must be the absolute
# host path to this `docker/` directory so updater compose commands use host-valid binds.
DRUVIA_VERSION=0.1.0
DRUVIA_UPDATER_URL=http://updater:3010
DRUVIA_UPDATER_SECRET=change_me_to_a_random_32_char_min_secret

# === API / browser-facing origin ===
# Single-domain deployment behind nginx / reverse proxy:
# keep both values pointing at the public site origin.
# Do not leave them empty in the current codebase, because some Admin pages
# still fall back to localhost when these variables are missing.
# `API_BASE_URL` is used by the API itself when generating storage public URLs
# and signed download URLs, so it should also point at the public site origin.
API_BASE_URL=https://druvia.logisticservice.site
INTERNAL_API_BASE_URL=http://api:3001
DENO_WORKER_URL=http://deno:7133
CORS_ORIGINS=https://druvia.logisticservice.site
TRUST_PROXY=true
NEXT_PUBLIC_API_URL=https://druvia.logisticservice.site
NEXT_PUBLIC_HASURA_URL=https://druvia.logisticservice.site


# Local storage (default provider)
# `STORAGE_HOST_PATH` is the host directory mounted into the API container.
# The default below matches the existing repo path where local storage objects live.
STORAGE_PROVIDER=local
STORAGE_HOST_PATH=../apps/api/data/storage

# Admin runtime variables
NEXT_PUBLIC_MULTI_TENANT_ENABLED=false
NEXT_PUBLIC_DEFAULT_TENANT_ID=default

# Host-bound internal service ports.
# When using Docker `with-nginx` as the public entrypoint, keep these ports
# restricted to localhost / VPC / security-group allowlist instead of public internet.
ADMIN_PORT=3000
API_PORT=3001
HASURA_PORT=8180

# Optional nginx profile ports (`--profile with-nginx`)
HTTP_PORT=80
HTTPS_PORT=443

# DNSPod-backed Let's Encrypt for built-in nginx profile
CERTBOT_EMAIL=admin@logisticservice.site
CERTBOT_PRIMARY_DOMAIN=logisticservice.site
CERTBOT_WILDCARD_DOMAIN=*.logisticservice.site

# Optional logging stack (`--profile with-logs`)
LOKI_PORT=3100
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Note:
# - For all-in-one Druvia deployment, enable `--profile with-nginx` and place
#   the DNSPod credentials file at `docker/nginx/secrets/dnspod.ini`.
# - `uat.logisticservice.site` 由生产 nginx 统一分发；请在
#   `docker/nginx/conf.d/40-druvia-uat.conf` 中把 RFC 5737 占位地址替换成 UAT 服务器的真实私网 IP / 内网 DNS。
# - The built-in `certbot` service will issue / renew Let's Encrypt certs and
#   sync them to `docker/nginx/ssl/fullchain.pem` and
#   `docker/nginx/ssl/privkey.pem`.
# - Example daily renew cron:
#   `0 3 * * * cd /path/to/Druvia && docker/certbot/renew-prod-certs.sh >> /var/log/druvia-certbot.log 2>&1`
# - If TLS / proxying is handled by an external nginx on the host, the Docker
#   `with-nginx` profile is optional.
# - Release-mode online update state is stored in the Docker named volume
#   `update_state`; include it in production host backups together with
#   PostgreSQL data and `.env.release`.
