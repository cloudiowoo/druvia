# Root environment for local development (`pnpm run dev` / `pnpm --filter @druvia/api dev`)
# The API service reads this file from the repository root.

# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (defaults below match the local Docker stack in this repo)
DB_HOST=localhost
DB_PORT=5532
DB_USER=postgres
DB_NAME=druvia
POSTGRES_PASSWORD=your_local_postgres_password

# Redis
REDIS_URL=redis://localhost:6479

# Hasura
HASURA_ENDPOINT=http://localhost:8180
HASURA_ADMIN_SECRET=your_hasura_admin_secret

# Core JWT / signing secrets
# Must be at least 32 characters for Hasura HS256 JWT verification.
JWT_SECRET=change_me_to_a_32_char_min_jwt_secret
STORAGE_TRUSTED_TICKET_SECRET=your_storage_trusted_ticket_secret_min_32_chars

# Optional but recommended in production-like environments
# PROJECT_AUTH_JWT_SECRET=your_project_auth_jwt_secret_min_32_chars
# FUNCTIONS_INTERNAL_TOKEN_SECRET=your_functions_internal_token_secret_min_32_chars
# SECRETS_ENCRYPTION_KEY=64_hex_characters_for_function_secret_encryption

# API base URLs used by storage / functions internals
API_BASE_URL=http://localhost:3001
# DENO_WORKER_URL=http://localhost:7133

# Optional TTL overrides
# PROJECT_AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# FUNCTIONS_INTERNAL_TOKEN_TTL_SECONDS=300
# STORAGE_TRUSTED_TICKET_MAX_TTL_SECONDS=900

# Storage
STORAGE_PROVIDER=local
STORAGE_PATH=./apps/api/data/storage
STORAGE_PUBLIC_URL=/storage

# Optional R2 storage adapter
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=druvia
# R2_PUBLIC_URL=
