# Root environment for local development (`pnpm run dev` / `pnpm --filter @druvia/api dev`)
# The API service reads this file from the repository root.

# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (defaults below match the local Docker stack in this repo)
DB_HOST=localhost
DB_PORT=5532
DB_USER=postgres
DB_NAME=druvia
POSTGRES_PASSWORD=your_local_postgres_password

# Redis
REDIS_URL=redis://localhost:6479

# Hasura
HASURA_ENDPOINT=http://localhost:8180
HASURA_ADMIN_SECRET=your_hasura_admin_secret
# Browser-reachable Hasura origin returned by the Realtime token exchange.
HASURA_PUBLIC_URL=http://localhost:8180

# Core JWT / signing secrets
# Must be at least 32 characters for Hasura HS256 JWT verification.
JWT_SECRET=change_me_to_a_32_char_min_jwt_secret
# Dedicated HS256 key shared only by Druvia API token issuance and Hasura verification.
# Existing deployments may temporarily omit this to fall back to JWT_SECRET.
HASURA_JWT_SECRET=change_me_to_a_distinct_32_char_min_secret
HASURA_REALTIME_TOKEN_TTL_SECONDS=300
STORAGE_TRUSTED_TICKET_SECRET=your_storage_trusted_ticket_secret_min_32_chars

# Optional but recommended in production-like environments
# PROJECT_AUTH_JWT_SECRET=your_project_auth_jwt_secret_min_32_chars
# Function token signing and API-to-Worker authentication.
# Keep these distinct in production; DENO_WORKER_SECRET must contain at least 32 UTF-8 bytes.
FUNCTIONS_INTERNAL_TOKEN_SECRET=your_functions_internal_token_secret_min_32_chars
DENO_WORKER_SECRET=your_worker_request_secret_min_32_utf8_bytes
# Required by Apple Auth; generate with `openssl rand -hex 32` and keep it distinct.
# SECRETS_ENCRYPTION_KEY=replace_me_with_64_hex_characters
# Required in production for account deletion status credentials and restore fences.
# Generate distinct values with `openssl rand -hex 32`; keep both stable across restores.
ACCOUNT_DELETION_STATUS_SECRET=replace_me_with_a_distinct_64_hex_value
ACCOUNT_DELETION_FENCE_SECRET=replace_me_with_another_distinct_64_hex_value
ACCOUNT_DELETION_EXECUTOR_ENABLED=true
# ACCOUNT_DELETION_EXECUTOR_POLL_MS=5000
# ACCOUNT_DELETION_EXECUTOR_LEASE_SECONDS=120
# ACCOUNT_DELETION_CLEANUP_TIMEOUT_MS=30000

# API base URLs used by storage / functions internals
API_BASE_URL=http://localhost:3001
# DENO_WORKER_URL=http://localhost:7133

# Optional TTL overrides
# PROJECT_AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# FUNCTIONS_INTERNAL_TOKEN_TTL_SECONDS=300
# STORAGE_TRUSTED_TICKET_MAX_TTL_SECONDS=900

# Storage
STORAGE_PROVIDER=local
STORAGE_PATH=./apps/api/data/storage
STORAGE_PUBLIC_URL=/storage

# Optional R2 storage adapter
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=druvia
# R2_PUBLIC_URL=
